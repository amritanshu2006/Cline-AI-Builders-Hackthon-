# PatchProof uses the @cline/sdk. Copy this file to ".env" (same folder as
# package.json) and fill in ONE provider section. Never commit ".env".
#
# IMPORTANT:
#   * The provider id must match one of the values in
#     node_modules/@cline/llms/dist/providers/ids.d.ts (BUILT_IN_PROVIDER enum).
#     Common values: "anthropic", "openai-native", "openai-compatible",
#     "openrouter", "cline", "gemini", "deepseek", "groq".
#     "openai" by itself is NOT a valid id – use "openai-native".
#   * "cline" is a special provider that uses Cline's own billing (Cline
#     credits, not an API key). Leave PP_API_KEY blank when using it.
#   * Every other provider needs PP_API_KEY set, otherwise PatchProof
#     refuses to run.

# ── Default fallback: Cline provider with no key required for demos ──
# (PP_REPLAY=1 demo does not use any provider; this only affects real runs.)
PP_PROVIDER=cline
PP_MODEL=anthropic/claude-sonnet-4.5
PP_API_KEY=

# ── OpenAI (https://platform.openai.com/api-keys) ──────────────────
# PP_PROVIDER=openai-native
# PP_MODEL=gpt-4o-mini
# PP_API_KEY=

# ── Anthropic (https://console.anthropic.com/) ────────────────────
# PP_PROVIDER=anthropic
# PP_MODEL=claude-sonnet-4-5
# PP_API_KEY=

# ── OpenRouter (https://openrouter.ai/keys) – one key, many models ─
# PP_PROVIDER=openrouter
# PP_MODEL=anthropic/claude-3.5-sonnet
# PP_API_KEY=

# ── Cline provider (no external key; uses Cline credits) ───────────
# PP_PROVIDER=cline
# PP_MODEL=anthropic/claude-sonnet-4.5
# PP_API_KEY=

# ── Optional knobs ─────────────────────────────────────────────────
# PP_REPLAY=1                      # opt-in offline replay (no AI credits used)
# PP_VERBOSE=1                     # log every Cline SDK event to stderr
# PP_AGENT_TIMEOUT_MS=180000       # per-session timeout, default 180s
# PP_SEMGREP_CONFIG=auto           # opt-in: fetch Semgrep auto rules over internet
# HOST=127.0.0.1                   # server bind address
# PORT=3000                        # server port
# CORS_ORIGINS=http://127.0.0.1:3000
# SEMGREP_BIN=/custom/path/to/semgrep
# GITHUB_TOKEN=                    # optional, used by /api/apply
